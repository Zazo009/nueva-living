CRM_WEBHOOK_URL=https://marbella-crm.vercel.app/api/webhook/liora
CRM_PROPERTY_WEBHOOK_URL=https://marbella-crm.vercel.app/api/webhook/property
CRM_WEBHOOK_SECRET=replace-with-shared-secret
PROPERTY_SYNC_TOKEN=replace-with-a-separate-admin-to-server-token
CRM_PROPERTY_SYNC_STRICT=false
ALLOWED_ORIGINS=https://nuevaliving.com,https://www.nuevaliving.com
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Meta Conversions API, read by netlify/functions/lib/meta-capi.js through
# nueva-lead.js and nueva-crm-event.js. Both are required together: with
# either one missing, sendMetaConversion() returns on its first line and no
# server-side event is ever sent -- silently, with the lead itself unaffected.
# That is the right behaviour for a live site and the worst kind of gap to
# inherit undocumented, which is why they are listed here.
#
# The dataset id is the pixel id, and it must be the same one build_dist.mjs
# writes into the pages as NUEVA_META_PIXEL_ID. Point them at two different
# datasets and the browser and server events stop deduplicating against each
# other, which counts every lead twice.
META_CAPI_TOKEN=replace-with-meta-conversions-api-token
META_DATASET_ID=replace-with-meta-dataset-id

# Signs the unsubscribe links in outgoing mail.
UNSUBSCRIBE_SECRET=replace-with-unsubscribe-signing-secret
